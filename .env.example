# Local preview is noindex by default. Build deliberately for a production release.
SITE_ENV=preview
SITE_URL=https://kyte-agency.com
HOST=127.0.0.1
PORT=4173
# Server-only HTTPS destination that accepts JSON project inquiries.
# Configure the actual owner's inbox/CRM webhook. Never put secrets in content JSON.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
